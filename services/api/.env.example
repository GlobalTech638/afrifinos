# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/afrifinos

# JWT/OIDC authentication
# The API requires signed bearer tokens on all non-public routes.
JWT_ISSUER=https://issuer.example.com/
JWT_AUDIENCE=afrifinos-api
JWT_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
